# Copy to .env.local and fill in. Never commit real keys.
# Anything prefixed VITE_ is embedded in the client bundle and is PUBLIC —
# only ever put publishable/public keys here. Secret keys belong on a server.

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Which provider the checkout page talks to. "mock" simulates the round-trip
# and charges nothing — that is the current default.
#
# To go live: write src/lib/payments/providers/<name>.js exporting
# createCheckout() and getCheckoutStatus(), register it in
# src/lib/payments/index.js, then set this. Checkout.jsx needs no changes.
VITE_PAYMENT_PROVIDER=mock

# --- Razorpay (India: UPI, cards, net banking) ---
# VITE_PAYMENT_PROVIDER=razorpay
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=            # server-side only, no VITE_ prefix

# --- Stripe (international, USD) ---
# VITE_PAYMENT_PROVIDER=stripe
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# STRIPE_SECRET_KEY=              # server-side only, no VITE_ prefix

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# submitEnquiry() in src/lib/enquiry.js is currently a stub. Point it at a
# serverless function and put the mail provider key on that server, not here.
# RESEND_API_KEY=
